    "_,tre_CLIP,A_CLIP, F_CLIP=score_ava(score_met_CLIP, score_not_met_CLIP, sous_CLIP ; pass=0.01, verb=true, rd=rd_CLIP)\n",
    "_,tre_CLIP_G,A_CLIP_G, F_CLIP_G=score_ava(score_met_CLIP_G, score_not_met_CLIP_G, sous_CLIP ; pass=0.01, verb=true,rd=rd_CLIP)\n",
    "_,tre_Deep_CLIP,A_Deep_CLIP, F_Deep_CLIP=score_ava(score_met_Deep_CLIP, score_not_Deep_CLIP, sous_CLIP ; pass=0.01, verb=true,rd=rd_CLIP)"
