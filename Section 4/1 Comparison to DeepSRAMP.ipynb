 "cells": [
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Packages needed for the notebook\n",
    "using CSV \n",
    "using Serialization \n",
    "using Revise \n",
    "using LinearAlgebra \n",
    "using ReverseDiff \n",
    "using Random \n",
    "using PyPlot \n",
    "using NaNStatistics \n",
    "using Statistics \n",
    "using LsqFit\n",
    "using DataFrames\n",
    "using FastaIO"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Including Files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "correct_path (generic function with 1 method)"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "function correct_path(splitted_path, String)\n",
    "    S=\"\"\n",
    "    for i in 1:(length(splitted_path)-1)\n",
    "        S=S*splitted_path[i]*\"/\"\n",
    "    end\n",
    "    return S*String \n",
    "end"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Including files with the functions\n",
    "includet(correct_path(split(pwd(), '/'), \"Functions/Variables and Structures.jl\")) #For constant quantities or structures to save data\n",
    "includet(correct_path(split(pwd(), '/'), \"Functions/Inference.jl\")) #For Training\n",
    "includet(correct_path(split(pwd(), '/'), \"Functions/Model Strategies and Testing.jl\")) #For scoring testing datasets\n",
    "includet(correct_path(split(pwd(), '/'), \"Functions/Performance Indicator.jl\")) #To compute performance over test datasets"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Datasets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"GLORI-seq\"\"\"\n",
    "#Importing constrcutred dataset\n",
    "train=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Train_GLORI.bin\")) \n",
    "test=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Test1_GLORI.bin\")) \n",
    "prior_HEK=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Prior_GLORI.bin\")); \n",
    "#Saving all the gene labels for the three datasets\n",
    "gene_train=keys(train);\n",
    "gene_test=keys(test);\n",
    "gene_prior=keys(prior_HEK);\n",
    "#All non methylated As\n",
    "train_met, ratio_train, gene_train_met, train_not, gene_train_not=crete_set_all(train, gene_train);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"miCLIP\"\"\"\n",
    "#Importing constrcutred dataset\n",
    "train_CLIP=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Train_miCLIP.bin\")) \n",
    "test_CLIP=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Test_miCLIP.bin\")) ;\n",
    "prior_CLIP=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Prior_miCLIP.bin\")) \n",
    "#Saving all the gene labels for the three datasets\n",
    "gene_train_CLIP=keys(train_CLIP);\n",
    "gene_test_CLIP=keys(test_CLIP);\n",
    "gene_prior_CLIP=keys(prior_CLIP);\n",
    "#All non methylated As\n",
    "train_met_CLIP, gene_train_met_CLIP, train_not_CLIP, gene_train_not_CLIP=crete_set_all(train_CLIP, gene_train_CLIP; verbose=false);"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Trained models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"GLORI\"\"\"\n",
    "#Importing models trained on GLORI HEK293T\n",
    "M5=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Model_met.bin\")) # p(s̄|m)\n",
    "M6=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Model_not_met.bin\")); # p(s̄|m̄)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"miCLIP\"\"\"\n",
    "C5=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Model_met_CLIP.bin\")) # p(s̄|m)\n",
    "C6=deserialize(correct_path(split(pwd(), '/'), \"Mapping/Data/Model_not_met_CLIP.bin\")); # p(s̄|m̄)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Distibution of motives (train-set):"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "bin=collect(0:0.001:1);\n",
    "avarege_window=20\n",
    "\n",
    "x_met, y_met=avarege_distribution(train, gene_train, avarege_window, bin; label=1)\n",
    "x_not, y_not=avarege_distribution(train, gene_train, avarege_window, bin;label=0);\n",
    "\n",
    "x_met_CLIP, y_met_CLIP=avarege_distribution(train_CLIP, gene_train_CLIP, avarege_window, bin; label=1)\n",
    "x_not_CLIP, y_not_CLIP=avarege_distribution(train_CLIP, gene_train_CLIP, avarege_window, bin; label=0);"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Constant-Prior"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"GLORI-seq\"\"\"\n",
    "Ava=[]\n",
    "[push!(Ava, train[a].perc_met) for a in gene_train];\n",
    "Ava=mean(Ava)\n",
    "\"\"\"miCLIP\"\"\"\n",
    "Ava_CLIP=[]\n",
    "[push!(Ava_CLIP, train_CLIP[a].perc_met) for a in gene_train_CLIP];\n",
    "Ava_CLIP=mean(Ava_CLIP);\n",
    "\n",
    "\"\"\"GLORI-seq\"\"\"\n",
    "constant_prior=deepcopy(test)\n",
    "#Constant prior to test over GLORI seq with models trained on miCLIP\n",
    "[constant_prior[a].perc_met=Ava_CLIP for a in keys(test)]\n",
    "\"\"\"miCLIP\"\"\"\n",
    "#Constant prior to test over miCLIP with models trained on GLORI\n",
    "constant_prior_CLIP=deepcopy(test_CLIP)\n",
    "[constant_prior_CLIP[a].perc_met=Ava for a in keys(test_CLIP)];"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Transcript Dependent-Prior"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"GLORI-seq\"\"\"\n",
    "P=[]\n",
    "[push!(P, prior_HEK[a].perc_met) for a in keys(prior_HEK)]\n",
    "[prior_HEK[a].perc_met=Ava/mean(P).*prior_HEK[a].perc_met for a in keys(prior_HEK)];\n",
    "\"\"\"miCLIP\"\"\"\n",
    "P=[]\n",
    "[push!(P, prior_CLIP[a].perc_met) for a in keys(prior_CLIP)]\n",
    "[prior_CLIP[a].perc_met=Ava/mean(P).*prior_CLIP[a].perc_met for a in keys(prior_CLIP)];"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### DeepSRAMP data"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "The following files were obtained from the state-of-the-art predictor DeepSRAMP (http://www.cuilab.cn/deepsramp/). \n",
    "\n",
    "See more details in Material and Methods for information relatively to its use for MEMAR comparison https://doi.org/10.64898/2026.10.26.761909"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"GLORI\"\"\"\n",
    "D_GLORI=CSV.read(correct_path(split(pwd(), '/'), \"Additional Files/DeepSRAMP GLORI output.csv\"), DataFrame, header=0) \n",
    "Seq_D_GLORI=readfasta(correct_path(split(pwd(), '/'), \"Additional Files/DeepSRAMP GLORI seqs.fasta\"))\n",
    "\"\"\"miCLIP\"\"\"\n",
    "D_CLIP=CSV.read(correct_path(split(pwd(), '/'), \"Additional Files/DeepSRAMP miCLIP output.csv\"), DataFrame, header=0) \n",
    "Seq_D_CLIP=readfasta(correct_path(split(pwd(), '/'), \"Additional Files/DeepSRAMP miCLIP seqs.fasta\"));"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [],
   "source": [
    "Dict_seq_GLORI=create_seq_dict(Seq_D_GLORI);\n",
    "Dict_seq_CLIP=create_seq_dict(Seq_D_CLIP);"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Common genes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The gene PLCL2 contain a (some) non-nucleotide(s) character(s) at position(s) [3518] corresponding to the chacracter(s): W \n"
     ]
    }
   ],
   "source": [
    "\"\"\"GLORI\"\"\"\n",
    "common_genes_GLORI=intersect(vcat(gene_test...),vcat(keys(Dict_seq_GLORI)...), vcat(gene_prior...)) ;\n",
    "genes_not=filtering_non_nucelotides(test)\n",
    "#Removing a gene with non canonical nucleotide letterse\n",
    "common_genes_GLORI=setdiff(common_genes_GLORI, genes_not); # T̃ ∩ T \\ T_n \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"miCLIP\"\"\"\n",
    "common_genes_CLIP=intersect(vcat(gene_test_CLIP...),vcat(keys(Dict_seq_CLIP)...), vcat(gene_prior_CLIP...)) ;\n",
    "genes_not_CLIP=filtering_non_nucelotides(test_CLIP)\n",
    "#Removing a gene with non canonical nucleotide letterse\n",
    "common_genes_CLIP=setdiff(common_genes_CLIP, genes_not_CLIP); # T̃ ∩ T \\ T_n "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Formatting DeepSRAMP results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "Dict_Deep_GLORI=format_Deep(D_GLORI, common_genes_GLORI, Dict_seq_GLORI);\n",
    "Dict_Deep_CLIP=format_Deep(D_CLIP, common_genes_CLIP,Dict_seq_CLIP);"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Mapping coding transcripts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [],
   "source": [
    "MAP_mRNA_GLORI=mapping_position(test, common_genes_GLORI);\n",
    "MAP_mRNA_CLIP=mapping_position(test_CLIP, common_genes_CLIP);"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Scoring GLORI sites"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "Dict_DRACH=Dict()\n",
    "[Dict_DRACH[a]=[]  for a in DRACH];"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"GLORI\"\"\"\n",
    "score_met_Deep_GLORI=scoring_Deep_met(keys(MAP_mRNA_GLORI),Dict_Deep_GLORI, test)\n",
    "score_not_Deep_GLORI=scoring_Deep_not(keys(MAP_mRNA_GLORI),Dict_Deep_GLORI, test)\n",
    "\"\"\"miCLIP\"\"\"\n",
    "score_met_Deep_CLIP=scoring_Deep_met(keys(MAP_mRNA_CLIP),Dict_Deep_CLIP, test_CLIP);\n",
    "score_not_Deep_CLIP=scoring_Deep_not(keys(MAP_mRNA_CLIP),Dict_Deep_CLIP, test_CLIP);"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of genes GLORI: 1259\n",
      "m6A sites GLORI: 7852\n",
      "A sites GLORI: 100975\n"
     ]
    }
   ],
   "source": [
    "println(\"Number of genes GLORI: $(length((score_met_Deep_GLORI)))\")\n",
    "println(\"m6A sites GLORI: $(length(vcat(score_met_Deep_GLORI...)))\")\n",
    "println(\"A sites GLORI: $(length(vcat(score_not_Deep_GLORI...)))\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of genes miCLIP: 301\n",
      "m6A sites GLORI: 554\n",
      "A sites GLORI: 23955\n"
     ]
    }
   ],
   "source": [
    "println(\"Number of genes miCLIP: $(length((score_met_Deep_CLIP)))\")\n",
    "println(\"m6A sites GLORI: $(length(vcat(score_met_Deep_CLIP...)))\")\n",
    "println(\"A sites GLORI: $(length(vcat(score_not_Deep_CLIP...)))\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   "outputs": [],
   "source": [
    "score_met_GLORI,score_not_met_GLORI, _=score_ps_ds_pm_DRACH(M5, M6,test,keys(MAP_mRNA_GLORI), prior_HEK;  verb=true, map=MAP_mRNA_GLORI,d_met=[x_met, y_met], d_not=[x_not, y_not] )\n",
    "score_met_GLORI_C,score_not_met_GLORI_C, _=score_ps_ds_pm_DRACH(C5, C6,test,keys(MAP_mRNA_GLORI), constant_prior;  verb=true, map=MAP_mRNA_GLORI,d_met=[x_met_CLIP, y_met_CLIP], d_not=[x_not_CLIP, y_not_CLIP] );"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "metadata": {},
   "outputs": [],
   "source": [
    "indexes_GLORI=shuffle!(vcat(1:length(score_met_GLORI)...))\n",
    "GLORI_ind_1=indexes_GLORI[1:floor(Int, length(score_met_GLORI)/3)]\n",
    "GLORI_ind_2=indexes_GLORI[floor(Int, length(score_met_GLORI)/3)+1:2*floor(Int, length(score_met_GLORI)/3)]\n",
    "GLORI_ind_3=indexes_GLORI[2*floor(Int, length(score_met_GLORI)/3)+1:end];\n",
    "sous_GLORI=[GLORI_ind_1,GLORI_ind_2,GLORI_ind_3];\n",
    "serialize(correct_path(split(pwd(), '/'), \"Mapping/Data/S_GLORI.bin\"),sous_GLORI);\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "metadata": {},
   "outputs": [],
   "source": [
    "rd_GLORI=[shuffle!(vcat(1:length(vcat(score_not_met_GLORI[i]...))...))[1:9*length(vcat(score_met_GLORI[i]...))] for i in sous_GLORI];"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "metadata": {},
   "outputs": [],
   "source": [
    "_,tre_GLORI,A_GLORI, F_GLORI=score_ava(score_met_GLORI, score_not_met_GLORI, sous_GLORI ; pass=0.01, verb=true, rd=rd_GLORI)\n",
    "_,tre_GLORI_C,A_GLORI_C, F_GLORI_C=score_ava(score_met_GLORI_C, score_not_met_GLORI_C, sous_GLORI ; pass=0.01, verb=true, rd=rd_GLORI)\n",
    "_,tre_Deep_GLORI,A_Deep_GLORI, F_Deep_GLORI=score_ava(score_met_Deep_GLORI, score_not_Deep_GLORI, sous_GLORI ; pass=0.01, verb=true, rd=rd_GLORI);"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Scoring miCLIP sites"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "metadata": {},
   "outputs": [],
   "source": [
    "score_met_CLIP_G,score_not_met_CLIP_G, _=score_ps_ds_pm_DRACH(M5, M6,test_CLIP,keys(MAP_mRNA_CLIP),constant_prior_CLIP;  verb=true, map=MAP_mRNA_CLIP, d_met=[x_met, y_met], d_not=[x_not, y_not] )\n",
    "score_met_CLIP,score_not_met_CLIP, _=score_ps_ds_pm_DRACH(C5, C6,test_CLIP,keys(MAP_mRNA_CLIP),prior_CLIP;  verb=true, map=MAP_mRNA_CLIP, d_met=[x_met_CLIP, y_met_CLIP], d_not=[x_not_CLIP, y_not_CLIP] );"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "metadata": {},
   "outputs": [],
   "source": [
    "indexes_CLIP=shuffle!(vcat(1:length(score_met_CLIP)...))\n",
    "CLIP_ind_1=indexes_CLIP[1:floor(Int, length(score_met_CLIP)/3)]\n",
    "CLIP_ind_2=indexes_CLIP[floor(Int, length(score_met_CLIP)/3)+1:2*floor(Int, length(score_met_CLIP)/3)]\n",
    "CLIP_ind_3=indexes_CLIP[2*floor(Int, length(score_met_CLIP)/3)+1:end];\n",
    "sous_CLIP=[CLIP_ind_1,CLIP_ind_2,CLIP_ind_3];\n",
    "serialize(correct_path(split(pwd(), '/'), \"Mapping/Data/S_CLIP.bin\"),sous_CLIP);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "metadata": {},
   "outputs": [],
   "source": [
    "rd_CLIP=[shuffle!(vcat(1:length(vcat(score_not_met_CLIP[i]...))...))[1:9*length(vcat(score_met_CLIP[i]...))] for i in sous_CLIP];"
   ]
  },
