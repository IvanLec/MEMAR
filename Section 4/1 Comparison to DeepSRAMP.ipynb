   "source": [
    "# Stochiometry comparison:\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Saving the list of methylated DRACH for each testing sequence and the corresponding stoichiometry from GLORI-seq data\n",
    "F_mots,r=methylated_mots(Dict_DRACH, MAP_mRNA_GLORI, test);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Computing the stoichiometry for each model\n",
    "stoc_Deep=stochiometry(F_mots, score_met_Deep_GLORI);\n",
    "stoc_MEMAR_CLIP=stochiometry(F_mots, score_met_GLORI_C);\n",
    "stoc_MEMAR_4=stochiometry(F_mots, score_met_GLORI);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Finding all DRACH motifs with at least 50 methylated sites and for which models have higher or equivalent predictions than the treshold\n",
    "Gs=[] #initialization of the empty list\n",
    "[((length(r[a])>=50 && isempty(findall(x->x>=0.1, stoc_MEMAR_CLIP[a]))==false && isempty(findall(x->x>=0.1, stoc_MEMAR_4[a]))==false && isempty(findall(x->x>=0.1, stoc_Deep[a]))==false)  ? push!(Gs, a) : nothing) for a in keys(Dict_DRACH)];"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "metadata": {},
   "outputs": [],
   "source": [
    "#average stoichiometry foe each DRACH sites methylated at least 50 times\n",
    "tdata=[mean(r[a]) for a in Gs]\n",
    "#predicted average stoichiometry for each DRACH site\n",
    "ydata=[mean(stoc_MEMAR_4[a][findall(x->x>=0.1, stoc_MEMAR_4[a])]) for a in Gs];\n",
    "ydata_C=[mean(stoc_MEMAR_CLIP[a][findall(x->x>=0.1, stoc_MEMAR_CLIP[a])]) for a in Gs];\n",
    "ydata_D=[mean(stoc_Deep[a][findall(x->x>=0.1, stoc_Deep[a])]) for a in Gs];\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Fitting with least square regression\n",
    "model(x, p) = p[1] .+ p[2] .* x\n",
    "p0=[0.0, 1.0]\n",
    "result_C = curve_fit(model, tdata, ydata_C, p0)\n",
    "result_D = curve_fit(model, tdata, ydata_D, p0)\n",
    "result = curve_fit(model, tdata, ydata, p0);"
   ]
  },
